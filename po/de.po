msgid "Reset all settings to default values"
msgstr "Alle Einstellungen auf Standardwerte zurücksetzen"

#: SettingsCenter@lauinger-clan.de/prefs.js:361
#: SettingsCenter@lauinger-clan.de/ui/prefs.ui:58
#: SettingsCenter@lauinger-clan.de/ui/prefs.ui:59
msgid "Select app"
msgstr "App auswählen"

#: SettingsCenter@lauinger-clan.de/schemas/org.gnome.shell.extensions.SettingsCenter.gschema.xml:6
msgid "Label Menu"
msgstr "Menü Beschriftung"

#: SettingsCenter@lauinger-clan.de/schemas/org.gnome.shell.extensions.SettingsCenter.gschema.xml:11
msgid "Items"
msgstr "Menü Einträge"

#: SettingsCenter@lauinger-clan.de/schemas/org.gnome.shell.extensions.SettingsCenter.gschema.xml:16
#: SettingsCenter@lauinger-clan.de/ui/prefs.ui:28
msgid "Toggle to show systemindicator"
